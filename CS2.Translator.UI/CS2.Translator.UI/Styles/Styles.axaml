<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Window background: subtle purple gradient -->
  <Style Selector="Window">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F0F14" Offset="0"/>
        <GradientStop Color="#1B1030" Offset="0.6"/>
        <GradientStop Color="#27123E" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- Header row -->
  <Style Selector="Border.header">
    <Setter Property="Background" Value="#0D0D0D"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="BorderBrush" Value="#3E3E7A"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!-- Chat bubble -->
  <Style Selector="Border.chat-bubble">
    <Setter Property="Background" Value="#1E1A2E"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="BorderBrush" Value="#7A5CFF"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>


  <!-- Name -->
  <Style Selector="TextBlock.chat-name">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#D7D5FF"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Original message -->
  <Style Selector="TextBlock.chat-original">
    <Setter Property="Foreground" Value="#BDBDBD"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>

  <!-- Translation -->
  <Style Selector="TextBlock.chat-translation">
    <Setter Property="Foreground" Value="#8BE9FD"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>

  <!-- Settings button style (accent) -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#2678D9"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>

</Styles>
